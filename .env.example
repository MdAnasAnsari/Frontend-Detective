# ==============================================================================
# Frontend Detective — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in the values below.
# NEVER commit your real '.env'. It is already listed in .gitignore.
# ==============================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development

# 2. Database Connection — REQUIRED
# MongoDB is the single source of truth for users, cases, scores and rooms.
# The server will refuse to start without this, by design: a silent fallback
# to on-disk JSON would appear to work while losing every write on Vercel.
# Free cluster: https://www.mongodb.com/cloud/atlas/register
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/frontend-detective?retryWrites=true&w=majority

# 3. JWT Secret — REQUIRED in production
# Signs session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a random per-process secret is used if this is blank, which
# means sessions do not survive a server restart.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 4. CORS — comma-separated list of allowed browser origins.
# Only needed when the API is served from a different origin than the client.
# The Vite dev server proxies /api, so the defaults cover local development.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
