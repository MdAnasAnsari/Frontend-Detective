# ==============================================================================
# Frontend Detective — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in your local environment or add these variables to
# your deployment platform (Vercel, Render, Railway, etc.).
# NEVER commit your real '.env' file containing secrets to version control.
# ==============================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development

# 2. Database Connection (MongoDB Atlas)
# Leave blank to use zero-setup persistent JSON storage in 'server/data/'.
# For cloud deployment (e.g. Vercel / Render), connect your free MongoDB Atlas cluster:
MONGO_URI=

# 3. JWT Secret (Optional - for enhanced production token signing)
JWT_SECRET=super-secret-frontend-detective-key-2026
